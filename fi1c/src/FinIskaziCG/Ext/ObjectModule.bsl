////////////////////////////////////////////////////////////////////////////////
// FinIskaziCG — Финансијски искази ЦГ (FI + PD)
//
// Модуль объекта. Вся логика: расчёт строк отчётности по данным
// РегистрБухгалтерии.МСФО и правилам маппинга, контроли, выгрузка XML (FI/PD),
// выгрузка XLSX/PDF.
//
// Все методы выполняются на сервере. Диалогов и клиентских вызовов здесь нет.
////////////////////////////////////////////////////////////////////////////////

Перем КэшМаппинга;      // Соответствие — разобранный макет ПравилаМаппинга
Перем КэшПравилPD;      // Массив       — разобранный макет ПравилаPD
Перем КэшДанныхУчета;   // Соответствие — "bal:2024:<uuid>" -> Соответствие(Код -> Структура(Дт, Кт))

#Область СлужебныеФункции

// Возвращает число либо 0 для любого другого типа.
Функция ЧислоИлиНоль(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Истина, если СтрокаПроверки начинается с указанного префикса.
Функция НачинаетсяС(Знач СтрокаПроверки, Знач Префикс)

	Если Префикс = "" Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Лев(СтрокаПроверки, СтрДлина(Префикс)) = Префикс;

КонецФункции

// Число в виде, пригодном для XML налоговой: точка-разделитель, без группировки.
Функция ЧислоДляXML(Знач Значение)

	Результат = Формат(ЧислоИлиНоль(Значение), "ЧН=0.00; ЧДЦ=2; ЧРД=.; ЧГ=0");
	Результат = СтрЗаменить(Результат, Символ(160), "");
	Результат = СтрЗаменить(Результат, " ", "");

	Возврат СокрЛП(Результат);

КонецФункции

// Год в виде строки без разделителей групп.
Функция ГодСтрокой(Знач ГодЧисло)

	Возврат Формат(ГодЧисло, "ЧГ=0");

КонецФункции

// Сбрасывает кэш прочитанных макетов и данных учёта.
Процедура СброситьКэш() Экспорт

	КэшМаппинга = Неопределено;
	КэшПравилPD = Неопределено;
	КэшДанныхУчета = Неопределено;

КонецПроцедуры

Процедура ПроверитьЗаполнениеПараметров()

	Если Не ЗначениеЗаполнено(Организация) Тогда
		ВызватьИсключение "FinIskaziCG: није изабрана организација.";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Год) ИЛИ Год < 1990 ИЛИ Год > 2200 Тогда
		ВызватьИсключение "FinIskaziCG: није исправно наведена година извјештаја.";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область РаботаСМакетами

Функция ПрочитатьJSONИзМакета(Знач ИмяМакета)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ПолучитьМакет(ИмяМакета).ПолучитьТекст());
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат Результат;

КонецФункции

Функция Маппинг()

	Если КэшМаппинга = Неопределено Тогда
		КэшМаппинга = ПрочитатьJSONИзМакета("ПравилаМаппинга");
	КонецЕсли;

	Возврат КэшМаппинга;

КонецФункции

Функция СекцииМаппинга()

	Результат = Маппинг().Получить("sections");

	Возврат ?(Результат = Неопределено, Новый Соответствие, Результат);

КонецФункции

// Массив правил (Соответствие) строк указанной секции в порядке шаблона.
Функция СтрокиСекцииМаппинга(Знач ИмяСекции)

	Секция = СекцииМаппинга().Получить(ИмяСекции);
	Если Секция = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Результат = Секция.Получить("rows");

	Возврат ?(Результат = Неопределено, Новый Массив, Результат);

КонецФункции

// Правила PD: Массив структур {code, label, source}.
// Допускается как массив в корне JSON, так и объект с ключом "rows".
Функция ПравилаPD()

	Если КэшПравилPD = Неопределено Тогда
		Прочитанное = ПрочитатьJSONИзМакета("ПравилаPD");
		Если ТипЗнч(Прочитанное) = Тип("Массив") Тогда
			КэшПравилPD = Прочитанное;
		ИначеЕсли ТипЗнч(Прочитанное) = Тип("Соответствие") Тогда
			Строки_ = Прочитанное.Получить("rows");
			КэшПравилPD = ?(Строки_ = Неопределено, Новый Массив, Строки_);
		Иначе
			КэшПравилPD = Новый Массив;
		КонецЕсли;
	КонецЕсли;

	Возврат КэшПравилPD;

КонецФункции

Функция ПрочитатьМакетXML(Знач ИмяМакета)

	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ПолучитьМакет(ИмяМакета).ПолучитьТекст());
	Построитель = Новый ПостроительDOM;
	Документ = Построитель.Прочитать(Чтение);
	Чтение.Закрыть();

	Возврат Документ;

КонецФункции

#КонецОбласти

#Область РаботаСDOM

Функция НайтиДочерний(Узел, Знач Имя)

	Для Каждого Дочерний Из Узел.ДочерниеУзлы Цикл
		Если Дочерний.ТипУзла = ТипУзлаDOM.Элемент И Дочерний.ИмяУзла = Имя Тогда
			Возврат Дочерний;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция КореньДокумента(Документ, Знач Имя)

	Результат = НайтиДочерний(Документ, Имя);
	Если Результат = Неопределено Тогда
		ВызватьИсключение "FinIskaziCG: у шаблону XML није пронађен корјени елемент <" + Имя + ">.";
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура УстановитьТекстУзла(Родитель, Знач Имя, Знач Значение)

	Если Родитель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Узел = НайтиДочерний(Родитель, Имя);
	Если Узел <> Неопределено Тогда
		Узел.ТекстовоеСодержимое = Строка(Значение);
	КонецЕсли;

КонецПроцедуры

Функция ТекстУзла(Родитель, Знач Имя)

	Узел = НайтиДочерний(Родитель, Имя);
	Если Узел = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Узел.ТекстовоеСодержимое);

КонецФункции

Процедура ЗаписатьДокументDOM(Документ, Знач ПутьФайла)

	Запись = Новый ЗаписьXML;
	Запись.ОткрытьФайл(ПутьФайла, "UTF-8");
	ЗаписьВDOM = Новый ЗаписьDOM;
	ЗаписьВDOM.Записать(Документ, Запись);
	Запись.Закрыть();

КонецПроцедуры

#КонецОбласти

#Область ДанныеУчета

Функция КонецОтчетногоГода(Знач ГодЧисло)

	Возврат КонецДня(Дата(ГодЧисло, 12, 31));

КонецФункции

Функция НачалоОтчетногоГода(Знач ГодЧисло)

	Возврат НачалоДня(Дата(ГодЧисло, 1, 1));

КонецФункции

// Свёртка результата запроса в Соответствие Код -> Структура("Дт, Кт").
// Оставляются ТОЛЬКО листовые счета: если код является строгим префиксом
// другого кода выборки, он отбрасывается (иначе агрегация задвоит суммы).
Функция СвернутьРезультат(РезультатЗапроса)

	Сырые = Новый Соответствие;

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Код = СокрЛП(Строка(Выборка.Код));
		Если Код = "" Тогда
			Продолжить;
		КонецЕсли;
		Текущий = Сырые.Получить(Код);
		Если Текущий = Неопределено Тогда
			Текущий = Новый Структура("Дт, Кт", 0, 0);
			Сырые.Вставить(Код, Текущий);
		КонецЕсли;
		Текущий.Дт = Текущий.Дт + ЧислоИлиНоль(Выборка.Дт);
		Текущий.Кт = Текущий.Кт + ЧислоИлиНоль(Выборка.Кт);
	КонецЦикла;

	// Помечаем все строгие префиксы имеющихся кодов как «не листья».
	НеЛистья = Новый Соответствие;
	Для Каждого КлючИЗначение Из Сырые Цикл
		Код = КлючИЗначение.Ключ;
		Для Позиция = 1 По СтрДлина(Код) - 1 Цикл
			НеЛистья.Вставить(Лев(Код, Позиция), Истина);
		КонецЦикла;
	КонецЦикла;

	Результат = Новый Соответствие;
	Для Каждого КлючИЗначение Из Сырые Цикл
		Если НеЛистья.Получить(КлючИЗначение.Ключ) = Неопределено Тогда
			Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ДанныеОстатков(Знач ГодЧисло)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Счет.Код КАК Код,
	|	Т.СуммаВВалютеОтчетностиОстатокДт КАК Дт,
	|	Т.СуммаВВалютеОтчетностиОстатокКт КАК Кт
	|ИЗ
	|	РегистрБухгалтерии.МСФО.Остатки(&Момент, , , Организация = &Орг И Сценарий.Наименование = ""Факт"") КАК Т";
	Запрос.УстановитьПараметр("Момент", КонецОтчетногоГода(ГодЧисло));
	Запрос.УстановитьПараметр("Орг", Организация);

	Возврат СвернутьРезультат(Запрос.Выполнить());

КонецФункции

Функция ДанныеОборотов(Знач ГодЧисло)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Счет.Код КАК Код,
	|	Т.СуммаВВалютеОтчетностиОборотДт КАК Дт,
	|	Т.СуммаВВалютеОтчетностиОборотКт КАК Кт
	|ИЗ
	|	РегистрБухгалтерии.МСФО.Обороты(&Нач, &Кон, , , , Организация = &Орг И Сценарий.Наименование = ""Факт"", , ) КАК Т";
	Запрос.УстановитьПараметр("Нач", НачалоОтчетногоГода(ГодЧисло));
	Запрос.УстановитьПараметр("Кон", КонецОтчетногоГода(ГодЧисло));
	Запрос.УстановитьПараметр("Орг", Организация);

	Возврат СвернутьРезультат(Запрос.Выполнить());

КонецФункции

// Данные учёта с кэшированием. Оборотные = Истина -> обороты за год,
// иначе — остатки на конец года.
Функция ДанныеУчета(Знач ГодЧисло, Знач Оборотные)

	Если КэшДанныхУчета = Неопределено Тогда
		КэшДанныхУчета = Новый Соответствие;
	КонецЕсли;

	КлючОрганизации = "";
	Если ЗначениеЗаполнено(Организация) Тогда
		КлючОрганизации = Строка(Организация.УникальныйИдентификатор());
	КонецЕсли;
	Ключ = ?(Оборотные, "turn:", "bal:") + ГодСтрокой(ГодЧисло) + ":" + КлючОрганизации;

	Данные = КэшДанныхУчета.Получить(Ключ);
	Если Данные = Неопределено Тогда
		Данные = ?(Оборотные, ДанныеОборотов(ГодЧисло), ДанныеОстатков(ГодЧисло));
		КэшДанныхУчета.Вставить(Ключ, Данные);
	КонецЕсли;

	Возврат Данные;

КонецФункции

#КонецОбласти

#Область РасчетСтрок

// Истина, если код счёта попадает под правило (include/exclude по префиксу).
Функция СчетПодходит(Знач Код, Включить, Исключить)

	Подходит = Ложь;
	Для Каждого Префикс Из Включить Цикл
		Если НачинаетсяС(Код, Строка(Префикс)) Тогда
			Подходит = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не Подходит Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Исключить <> Неопределено Тогда
		Для Каждого Префикс Из Исключить Цикл
			Если НачинаетсяС(Код, Строка(Префикс)) Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Агрегация суммы по правилу kind = "account" за указанный год.
//   debitNet / turnoverDebitNet   — Σ(Дт − Кт)
//   creditNet / turnoverCreditNet — Σ(Кт − Дт)
//   debitOnly                     — Σ макс(Дт − Кт, 0) по КАЖДОМУ счёту
//   creditOnly                    — Σ макс(Кт − Дт, 0) по КАЖДОМУ счёту
Функция РассчитатьПоПравилу(ПравилоСтроки, Знач ГодЧисло)

	Счета = ПравилоСтроки.Получить("accounts");
	ВидБаланса = ПравилоСтроки.Получить("balance");
	Если Счета = Неопределено ИЛИ ВидБаланса = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Включить = Счета.Получить("include");
	Если Включить = Неопределено ИЛИ Включить.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Исключить = Счета.Получить("exclude");

	ВидБаланса = Строка(ВидБаланса);
	Оборотные = НачинаетсяС(ВидБаланса, "turnover");
	Данные = ДанныеУчета(ГодЧисло, Оборотные);

	Итог = 0;
	Для Каждого КлючИЗначение Из Данные Цикл
		Если Не СчетПодходит(КлючИЗначение.Ключ, Включить, Исключить) Тогда
			Продолжить;
		КонецЕсли;
		СуммаДт = КлючИЗначение.Значение.Дт;
		СуммаКт = КлючИЗначение.Значение.Кт;
		Если ВидБаланса = "debitNet" ИЛИ ВидБаланса = "turnoverDebitNet" Тогда
			Итог = Итог + (СуммаДт - СуммаКт);
		ИначеЕсли ВидБаланса = "creditNet" ИЛИ ВидБаланса = "turnoverCreditNet" Тогда
			Итог = Итог + (СуммаКт - СуммаДт);
		ИначеЕсли ВидБаланса = "debitOnly" Тогда
			Итог = Итог + Макс(СуммаДт - СуммаКт, 0);
		ИначеЕсли ВидБаланса = "creditOnly" Тогда
			Итог = Итог + Макс(СуммаКт - СуммаДт, 0);
		КонецЕсли;
	КонецЦикла;

	Возврат Окр(Итог, 2);

КонецФункции

// ЕДИНАЯ точка, задающая семантику колонок Iznos1..Iznos3 для секции.
//
// Возвращает Массив из 3 элементов: год, за который считается колонка,
// либо Неопределено — колонка автоматически НЕ рассчитывается (только
// формулы и ручные Корректировки).
//
// Подтверждено Правилником (research/fi_columns.md):
//   BilanStanja  : кол.5 tekuća godina, кол.6 prethodna godina — krajnje stanje,
//                  кол.7 prethodna godina — POČETNO stanje. Кол.7 заполняется
//                  ТОЛЬКО при ретроспективном пересчёте/реклассификации,
//                  поэтому по умолчанию = 0 (руками через Корректировки).
//   BilanUspjeha, StatistickiAneks : кол.5 tekuća, кол.6 prethodna godina.
//   Токови готовине / капитал / амортизација : ручной ввод.
Функция МоментыКолонок(Знач ИмяСекции) Экспорт

	Результат = Новый Массив;
	Результат.Добавить(Неопределено);
	Результат.Добавить(Неопределено);
	Результат.Добавить(Неопределено);

	Если ИмяСекции = "BilanStanja" Тогда
		Результат[0] = Год;
		Результат[1] = Год - 1;
		// Результат[2] намеренно оставлен Неопределено — см. комментарий выше.
	ИначеЕсли ИмяСекции = "BilanUspjeha" ИЛИ ИмяСекции = "StatistickiAneks" Тогда
		Результат[0] = Год;
		Результат[1] = Год - 1;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Порядок секций — строго по шаблону FI (без Zaglavlje).
Функция ПорядокСекций() Экспорт

	Результат = Новый Массив;
	Документ = ПрочитатьМакетXML("ШаблонFI");
	Корень = КореньДокумента(Документ, "FinansijskiIskazi");

	Для Каждого Узел Из Корень.ДочерниеУзлы Цикл
		Если Узел.ТипУзла <> ТипУзлаDOM.Элемент Тогда
			Продолжить;
		КонецЕсли;
		Если Узел.ИмяУзла = "Zaglavlje" Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Узел.ИмяУзла);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Соответствие "Секция|Номер|Колонка" -> суммарная ручная поправка.
Функция ДельтыКорректировок()

	Результат = Новый Соответствие;

	Для Каждого Строка_ Из Корректировки Цикл
		НомерКолонки = Цел(ЧислоИлиНоль(Строка_.Колонка));
		Если НомерКолонки < 1 ИЛИ НомерКолонки > 3 Тогда
			Продолжить;
		КонецЕсли;
		Ключ = СокрЛП(Строка_.Секция) + "|" + СокрЛП(Строка_.RedniBroj) + "|" + Строка(НомерКолонки);
		Результат.Вставить(Ключ, ЧислоИлиНоль(Результат.Получить(Ключ)) + ЧислоИлиНоль(Строка_.Сумма));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Разбор выражения формулы: последовательность номеров строк со знаками + / −.
// Номера могут содержать буквы ("210a", "15a"). Регулярных выражений нет.
// Если хотя бы один номер неизвестен — Успех = Ложь.
Функция ВычислитьВыражение(Знач Выражение, Значения, Успех)

	Итог = 0;
	Знак = 1;
	Токен = "";
	Текст = СтрЗаменить(СокрЛП(Строка(Выражение)), " ", "");
	// разные виды тире, встречающиеся в бланках, приводим к минусу
	Текст = СтрЗаменить(Текст, Символ(8211), "-");
	Текст = СтрЗаменить(Текст, Символ(8212), "-");

	Позиция = 1;
	Пока Позиция <= СтрДлина(Текст) + 1 Цикл
		Если Позиция > СтрДлина(Текст) Тогда
			Симв = "+";
		Иначе
			Симв = Сред(Текст, Позиция, 1);
		КонецЕсли;

		Если Симв = "+" ИЛИ Симв = "-" Тогда
			Если Токен <> "" Тогда
				Величина = Значения.Получить(Токен);
				Если Величина = Неопределено Тогда
					Успех = Ложь;
					Возврат 0;
				КонецЕсли;
				Итог = Итог + Знак * Величина;
			КонецЕсли;
			Знак = ?(Симв = "+", 1, -1);
			Токен = "";
		Иначе
			Токен = Токен + Симв;
		КонецЕсли;

		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Многопроходный расчёт формульных строк одной секции по одной колонке.
Процедура ВычислитьФормулыСекции(Знач ИмяСекции, Знач НомерКолонки, Формулы, Дельты)

	ИмяКолонки = "Iznos" + Строка(НомерКолонки);

	Значения = Новый Соответствие;
	СтрокиФормул = Новый Соответствие;

	Для Каждого Строка_ Из Строки Цикл
		Если Строка_.Секция <> ИмяСекции Тогда
			Продолжить;
		КонецЕсли;
		Номер = СокрЛП(Строка_.RedniBroj);
		Если Номер = "" Тогда
			Продолжить;
		КонецЕсли;
		Если Строка_.Kind = "formula" Тогда
			СтрокиФормул.Вставить(Номер, Строка_);
		Иначе
			Значения.Вставить(Номер, ЧислоИлиНоль(Строка_[ИмяКолонки]));
		КонецЕсли;
	КонецЦикла;

	Если СтрокиФормул.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Проход = 1 По 10 Цикл
		Изменений = 0;
		Для Каждого КлючИЗначение Из СтрокиФормул Цикл
			Если Значения.Получить(КлючИЗначение.Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Выражение = Формулы.Получить(КлючИЗначение.Ключ);
			Если Выражение = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Успех = Истина;
			Величина = ВычислитьВыражение(Выражение, Значения, Успех);
			Если Успех Тогда
				Поправка = Дельты.Получить(ИмяСекции + "|" + КлючИЗначение.Ключ + "|" + Строка(НомерКолонки));
				Если Поправка <> Неопределено Тогда
					Величина = Величина + Поправка;
				КонецЕсли;
				Величина = Окр(Величина, 2);
				Значения.Вставить(КлючИЗначение.Ключ, Величина);
				КлючИЗначение.Значение[ИмяКолонки] = Величина;
				Изменений = Изменений + 1;
			КонецЕсли;
		КонецЦикла;
		Если Изменений = 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	// Строки, которые не удалось вычислить (циклы / битые ссылки) — обнуляем.
	Для Каждого КлючИЗначение Из СтрокиФормул Цикл
		Если Значения.Получить(КлючИЗначение.Ключ) = Неопределено Тогда
			КлючИЗначение.Значение[ИмяКолонки] = 0;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Пересчёт всех формульных строк всех секций по всем трём колонкам.
Процедура ПересчитатьФормулы() Экспорт

	Дельты = ДельтыКорректировок();

	СекцииКРасчету = Новый Соответствие;
	Для Каждого Строка_ Из Строки Цикл
		СекцииКРасчету.Вставить(Строка_.Секция, Истина);
	КонецЦикла;

	Для Каждого КлючИЗначение Из СекцииКРасчету Цикл
		ИмяСекции = КлючИЗначение.Ключ;
		Формулы = Новый Соответствие;
		Для Каждого Правило Из СтрокиСекцииМаппинга(ИмяСекции) Цикл
			Если Строка(Правило.Получить("kind")) = "formula" Тогда
				Формулы.Вставить(СокрЛП(Строка(Правило.Получить("redniBroj"))),
					Строка(Правило.Получить("formula")));
			КонецЕсли;
		КонецЦикла;
		Если Формулы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для НомерКолонки = 1 По 3 Цикл
			ВычислитьФормулыСекции(ИмяСекции, НомерКолонки, Формулы, Дельты);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Ручные поправки применяются ко ВСЕМ нефомульным строкам (для kind = "manual"
// это единственный источник значения). Формульные строки получают свою поправку
// внутри ВычислитьФормулыСекции — уже поверх вычисленного значения, чтобы
// поправка корректно попадала в вышестоящие итоги.
Процедура ПрименитьКорректировки()

	Дельты = ДельтыКорректировок();
	Если Дельты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Строка_ Из Строки Цикл
		Если Строка_.Kind = "formula" Тогда
			Продолжить;
		КонецЕсли;
		Для НомерКолонки = 1 По 3 Цикл
			Ключ = Строка_.Секция + "|" + СокрЛП(Строка_.RedniBroj) + "|" + Строка(НомерКолонки);
			Поправка = Дельты.Получить(Ключ);
			Если Поправка <> Неопределено Тогда
				ИмяКолонки = "Iznos" + Строка(НомерКолонки);
				Строка_[ИмяКолонки] = Окр(ЧислоИлиНоль(Строка_[ИмяКолонки]) + Поправка, 2);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Значение строки отчёта по (Секция, RedniBroj, номер колонки).
// Возвращает Неопределено, если строка не найдена.
Функция ЗначениеСтроки(Знач ИмяСекции, Знач Номер, Знач НомерКолонки) Экспорт

	Отбор = Новый Структура("Секция, RedniBroj", ИмяСекции, СокрЛП(Номер));
	Найденные = Строки.НайтиСтроки(Отбор);
	Если Найденные.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ЧислоИлиНоль(Найденные[0]["Iznos" + Строка(НомерКолонки)]);

КонецФункции

#КонецОбласти

#Область ЗаполнениеТабличныхЧастей

// Основной расчёт: строит ТЧ Строки по порядку шаблона FI и правилам маппинга.
Процедура Заполнить() Экспорт

	ПроверитьЗаполнениеПараметров();

	// Заполнить() = полный пересчёт от данных базы, поэтому кэш запросов сбрасываем.
	КэшДанныхУчета = Неопределено;

	Строки.Очистить();

	Для Каждого ИмяСекции Из ПорядокСекций() Цикл
		Колонки = МоментыКолонок(ИмяСекции);
		Для Каждого Правило Из СтрокиСекцииМаппинга(ИмяСекции) Цикл
			НоваяСтрока = Строки.Добавить();
			НоваяСтрока.Секция = ИмяСекции;
			НоваяСтрока.RedniBroj = Лев(СокрЛП(Строка(Правило.Получить("redniBroj"))), 10);
			НоваяСтрока.Позиция = Лев(Строка(Правило.Получить("pozicija")), 500);
			НоваяСтрока.GrupaRacuna = Лев(Строка(Правило.Получить("grupaRacuna")), 200);
			НоваяСтрока.Kind = Лев(Строка(Правило.Получить("kind")), 10);

			Счета = Правило.Получить("accounts");
			НоваяСтрока.Дио = (Счета <> Неопределено И Счета.Получить("dio") <> Неопределено);

			Если НоваяСтрока.Kind = "account" Тогда
				Для НомерКолонки = 1 По 3 Цикл
					ГодКолонки = Колонки[НомерКолонки - 1];
					Если ГодКолонки = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					НоваяСтрока["Iznos" + Строка(НомерКолонки)] = РассчитатьПоПравилу(Правило, ГодКолонки);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ПрименитьКорректировки();
	ПересчитатьФормулы();

	ЗаполнитьСтрокиКапитала();
	ЗаполнитьСтрокиАмортизации();
	ПересчитатьКапитал();
	ПересчитатьАмортизацию();

КонецПроцедуры

// Строки «Исказ о промјенама на капиталу» (9 позиций, колонки Iznos2..Iznos11).
// Значения сохраняются, если структура уже совпадает.
Процедура ЗаполнитьСтрокиКапитала() Экспорт

	Правила = СтрокиСекцииМаппинга("IskazOPromenamaKapitala");

	Если СтрокиКапитала.Количество() <> Правила.Количество() Тогда
		СтрокиКапитала.Очистить();
		Для Каждого Правило Из Правила Цикл
			СтрокиКапитала.Добавить();
		КонецЦикла;
	КонецЕсли;

	Индекс = 0;
	Для Каждого Правило Из Правила Цикл
		Строка_ = СтрокиКапитала[Индекс];
		Строка_.Позиция = Лев(СокрЛП(Строка(Правило.Получить("redniBroj"))), 10);
		Строка_.Опис = Лев(Строка(Правило.Получить("pozicija")), 300);
		Индекс = Индекс + 1;
	КонецЦикла;

КонецПроцедуры

// Ставки налоговой амортизации по группам I..V (Iznos6 в Обрасцу OA).
// С 01.01.2024 — 2.5 / 10 / 15 / 20 / 30 %; ранее — 5 / 15 / 20 / 25 / 30 %.
Функция СтавкиАмортизации()

	Результат = Новый Соответствие;

	Если Год >= 2024 Тогда
		Результат.Вставить("I", 2.5);
		Результат.Вставить("II", 10);
		Результат.Вставить("III", 15);
		Результат.Вставить("IV", 20);
		Результат.Вставить("V", 30);
	Иначе
		Результат.Вставить("I", 5);
		Результат.Вставить("II", 15);
		Результат.Вставить("III", 20);
		Результат.Вставить("IV", 25);
		Результат.Вставить("V", 30);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ЗаполнитьСтрокиАмортизации() Экспорт

	Правила = СтрокиСекцииМаппинга("ObracunAmortizacije");

	Если СтрокиАмортизации.Количество() <> Правила.Количество() Тогда
		СтрокиАмортизации.Очистить();
		Для Каждого Правило Из Правила Цикл
			СтрокиАмортизации.Добавить();
		КонецЦикла;
	КонецЕсли;

	Ставки = СтавкиАмортизации();

	Индекс = 0;
	Для Каждого Правило Из Правила Цикл
		Строка_ = СтрокиАмортизации[Индекс];
		Строка_.Grupa = Лев(СокрЛП(Строка(Правило.Получить("redniBroj"))), 5);
		Если ЧислоИлиНоль(Строка_.Iznos6) = 0 Тогда
			Ставка = Ставки.Получить(СокрЛП(Строка_.Grupa));
			Строка_.Iznos6 = ?(Ставка = Неопределено, 0, Ставка);
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;

КонецПроцедуры

// Исказ о промјенама на капиталу: строки 3 = 1+2, 5 = 3+4, 7 = 5+6, 9 = 7+8;
// колонка 11 (Ukupno) = кол. 2+3+4+5+6+7+8−9−10.
Процедура ПересчитатьКапитал() Экспорт

	Если СтрокиКапитала.Количество() < 9 Тогда
		Возврат;
	КонецЕсли;

	Пары = Новый Массив;
	Пары.Добавить(Новый Структура("Цель, Первое, Второе", 3, 1, 2));
	Пары.Добавить(Новый Структура("Цель, Первое, Второе", 5, 3, 4));
	Пары.Добавить(Новый Структура("Цель, Первое, Второе", 7, 5, 6));
	Пары.Добавить(Новый Структура("Цель, Первое, Второе", 9, 7, 8));

	Для Каждого Пара Из Пары Цикл
		Цель = СтрокиКапитала[Пара.Цель - 1];
		Первое = СтрокиКапитала[Пара.Первое - 1];
		Второе = СтрокиКапитала[Пара.Второе - 1];
		Для НомерКолонки = 2 По 10 Цикл
			ИмяКолонки = "Iznos" + Строка(НомерКолонки);
			Цель[ИмяКолонки] = Окр(ЧислоИлиНоль(Первое[ИмяКолонки]) + ЧислоИлиНоль(Второе[ИмяКолонки]), 2);
		КонецЦикла;
	КонецЦикла;

	Для Каждого Строка_ Из СтрокиКапитала Цикл
		Итог = 0;
		Для НомерКолонки = 2 По 8 Цикл
			Итог = Итог + ЧислоИлиНоль(Строка_["Iznos" + Строка(НомерКолонки)]);
		КонецЦикла;
		Итог = Итог - ЧислоИлиНоль(Строка_.Iznos9) - ЧислоИлиНоль(Строка_.Iznos10);
		Строка_.Iznos11 = Окр(Итог, 2);
	КонецЦикла;

КонецПроцедуры

// Обрасц OA: Iznos5 = 2+3−4, Iznos7 = 5×6/100, Iznos8 = 5−7.
Процедура ПересчитатьАмортизацию() Экспорт

	Для Каждого Строка_ Из СтрокиАмортизации Цикл
		Строка_.Iznos5 = Окр(ЧислоИлиНоль(Строка_.Iznos2) + ЧислоИлиНоль(Строка_.Iznos3)
			- ЧислоИлиНоль(Строка_.Iznos4), 2);
		Строка_.Iznos7 = Окр(Строка_.Iznos5 * ЧислоИлиНоль(Строка_.Iznos6) / 100, 2);
		Строка_.Iznos8 = Окр(Строка_.Iznos5 - Строка_.Iznos7, 2);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Контроли

// Возвращает текст с расхождениями или "" если всё сошлось.
Функция ПроверитьКонтроли() Экспорт

	Ошибки = Новый Массив;

	// 1. Актив = Пассив по каждой колонке (BilanStanja 046 vs 144).
	Для НомерКолонки = 1 По 3 Цикл
		Актив = ЗначениеСтроки("BilanStanja", "046", НомерКолонки);
		Пассив = ЗначениеСтроки("BilanStanja", "144", НомерКолонки);
		Если Актив = Неопределено ИЛИ Пассив = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Окр(Актив - Пассив, 2) <> 0 Тогда
			Ошибки.Добавить("BilanStanja, колона " + Строка(НомерКолонки)
				+ ": AKTIVA (046) = " + Формат(Актив, "ЧДЦ=2")
				+ ", PASIVA (144) = " + Формат(Пассив, "ЧДЦ=2")
				+ ", разлика = " + Формат(Окр(Актив - Пассив, 2), "ЧДЦ=2"));
		КонецЕсли;
	КонецЦикла;

	// 2. Сверка групповых итогов с GrupaRacuna (mapping_notes §5.5).
	Для Каждого Контроль Из ГрупповыеКонтроли() Цикл
		Колонки = МоментыКолонок(Контроль.Секция);
		Для НомерКолонки = 1 По 3 Цикл
			ГодКолонки = Колонки[НомерКолонки - 1];
			Если ГодКолонки = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Факт = ЗначениеСтроки(Контроль.Секция, Контроль.Номер, НомерКолонки);
			Если Факт = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Эталон = РассчитатьПоПравилу(ПравилоПоПрефиксу(Контроль.Префикс, Контроль.Вид), ГодКолонки);
			Если Окр(Факт - Эталон, 2) <> 0 Тогда
				Ошибки.Добавить(Контроль.Секция + " " + Контроль.Номер + ", колона "
					+ Строка(НомерКолонки) + ": ред = " + Формат(Факт, "ЧДЦ=2")
					+ ", " + Контроль.Вид + "(" + Контроль.Префикс + ") = " + Формат(Эталон, "ЧДЦ=2")
					+ ", разлика = " + Формат(Окр(Факт - Эталон, 2), "ЧДЦ=2"));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// 3. Формулы сходятся с текущими значениями строк.
	ПроверитьФормулы(Ошибки);

	Результат = "";
	Для Каждого Текст Из Ошибки Цикл
		Результат = Результат + ?(Результат = "", "", Символы.ПС) + Текст;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ГрупповыеКонтроли()

	Результат = Новый Массив;
	Результат.Добавить(Новый Структура("Секция, Номер, Префикс, Вид", "BilanStanja", "003", "01", "debitNet"));
	Результат.Добавить(Новый Структура("Секция, Номер, Префикс, Вид", "BilanStanja", "122", "41", "creditNet"));

	Возврат Результат;

КонецФункции

// Синтетическое правило kind = "account" для одного префикса — чтобы
// переиспользовать РассчитатьПоПравилу в контролях.
Функция ПравилоПоПрефиксу(Знач Префикс, Знач ВидБаланса)

	Включить = Новый Массив;
	Включить.Добавить(Префикс);

	Счета = Новый Соответствие;
	Счета.Вставить("include", Включить);

	Правило = Новый Соответствие;
	Правило.Вставить("accounts", Счета);
	Правило.Вставить("balance", ВидБаланса);

	Возврат Правило;

КонецФункции

Процедура ПроверитьФормулы(Ошибки)

	Дельты = ДельтыКорректировок();

	СекцииКПроверке = Новый Соответствие;
	Для Каждого Строка_ Из Строки Цикл
		СекцииКПроверке.Вставить(Строка_.Секция, Истина);
	КонецЦикла;

	Для Каждого КлючИЗначение Из СекцииКПроверке Цикл
		ИмяСекции = КлючИЗначение.Ключ;

		Формулы = Новый Соответствие;
		Для Каждого Правило Из СтрокиСекцииМаппинга(ИмяСекции) Цикл
			Если Строка(Правило.Получить("kind")) = "formula" Тогда
				Формулы.Вставить(СокрЛП(Строка(Правило.Получить("redniBroj"))),
					Строка(Правило.Получить("formula")));
			КонецЕсли;
		КонецЦикла;
		Если Формулы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Для НомерКолонки = 1 По 3 Цикл
			ИмяКолонки = "Iznos" + Строка(НомерКолонки);
			Значения = Новый Соответствие;
			Для Каждого Строка_ Из Строки Цикл
				Если Строка_.Секция <> ИмяСекции Тогда
					Продолжить;
				КонецЕсли;
				Номер = СокрЛП(Строка_.RedniBroj);
				Если Номер <> "" Тогда
					Значения.Вставить(Номер, ЧислоИлиНоль(Строка_[ИмяКолонки]));
				КонецЕсли;
			КонецЦикла;

			Для Каждого ФормулаКлюч Из Формулы Цикл
				Текущее = Значения.Получить(ФормулаКлюч.Ключ);
				Если Текущее = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Успех = Истина;
				Расчетное = ВычислитьВыражение(ФормулаКлюч.Значение, Значения, Успех);
				Если Не Успех Тогда
					Продолжить;
				КонецЕсли;
				Поправка = Дельты.Получить(ИмяСекции + "|" + ФормулаКлюч.Ключ + "|" + Строка(НомерКолонки));
				Если Поправка <> Неопределено Тогда
					Расчетное = Расчетное + Поправка;
				КонецЕсли;
				Если Окр(Текущее - Расчетное, 2) <> 0 Тогда
					Ошибки.Добавить(ИмяСекции + " " + ФормулаКлюч.Ключ + ", колона "
						+ Строка(НомерКолонки) + ": у реду " + Формат(Текущее, "ЧДЦ=2")
						+ ", по формули (" + ФормулаКлюч.Значение + ") "
						+ Формат(Окр(Расчетное, 2), "ЧДЦ=2"));
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область РасчетPD

// Прогрессивная шкала налога на прибыль (čl. 28 Zakona o porezu na dobit):
//   до 100 000        — 9 %
//   100 000..1 500 000 — 9 000 + 12 % от превышения
//   свыше 1 500 000    — 177 000 + 15 % от превышения
// Часть: "A" | "B" | "C" | "" (итог).
Функция НалогПоШкале(Знач База, Знач Часть)

	Если ЧислоИлиНоль(База) <= 0 Тогда
		Возврат 0;
	КонецЕсли;

	ЧастьA = Мин(База, 100000) * 0.09;
	ЧастьB = Макс(Мин(База, 1500000) - 100000, 0) * 0.12;
	ЧастьC = Макс(База - 1500000, 0) * 0.15;

	Если Часть = "A" Тогда
		Возврат Окр(ЧастьA, 2);
	ИначеЕсли Часть = "B" Тогда
		Возврат Окр(ЧастьB, 2);
	ИначеЕсли Часть = "C" Тогда
		Возврат Окр(ЧастьC, 2);
	КонецЕсли;

	Возврат Окр(ЧастьA + ЧастьB + ЧастьC, 2);

КонецФункции

// Источник вида "BilanUspjeha:244:1" -> значение строки FI.
Функция ЗначениеИзFI(Знач Спецификация)

	Части = СтрРазделить(Спецификация, ":", Ложь);
	Если Части.Количество() < 3 Тогда
		Возврат 0;
	КонецЕсли;

	НомерКолонки = 1;
	Попытка
		НомерКолонки = Число(СокрЛП(Части[2]));
	Исключение
		НомерКолонки = 1;
	КонецПопытки;

	Величина = ЗначениеСтроки(СокрЛП(Части[0]), СокрЛП(Части[1]), НомерКолонки);

	Возврат ?(Величина = Неопределено, 0, Величина);

КонецФункции

Функция СуммаКолонкиАмортизации(Знач ИмяКолонки)

	Итог = 0;
	Для Каждого Строка_ Из СтрокиАмортизации Цикл
		Попытка
			Итог = Итог + ЧислоИлиНоль(Строка_[ИмяКолонки]);
		Исключение
			Возврат 0;
		КонецПопытки;
	КонецЦикла;

	Возврат Окр(Итог, 2);

КонецФункции

// Значения источников, не зависящих от других строк PD.
// Возвращает Неопределено, если источник «отложенный» (формула / шкала / min).
Функция ПрямойИсточникPD(Знач Источник)

	Если Источник = "manual" ИЛИ Источник = "" Тогда
		Возврат Неопределено;
	ИначеЕсли НачинаетсяС(Источник, "fiPos:") Тогда
		Возврат Макс(ЗначениеИзFI(Сред(Источник, 7)), 0);
	ИначеЕсли НачинаетсяС(Источник, "fiNeg:") Тогда
		Возврат Макс(-ЗначениеИзFI(Сред(Источник, 7)), 0);
	ИначеЕсли НачинаетсяС(Источник, "fi:") Тогда
		Возврат ЗначениеИзFI(Сред(Источник, 4));
	ИначеЕсли НачинаетсяС(Источник, "oaSum:") Тогда
		Возврат СуммаКолонкиАмортизации(СокрЛП(Сред(Источник, 7)));
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Пересчёт всех автоматических строк PD (многопроходно).
Процедура ПересчитатьPD() Экспорт

	Источники = Новый Соответствие;
	Для Каждого Правило Из ПравилаPD() Цикл
		Источники.Вставить(СокрЛП(Строка(Правило.Получить("code"))),
			СокрЛП(Строка(Правило.Получить("source"))));
	КонецЦикла;

	Значения = Новый Соответствие;
	СтрокиПоКоду = Новый Соответствие;
	Для Каждого Строка_ Из PDСтроки Цикл
		Код = СокрЛП(Строка_.Код);
		СтрокиПоКоду.Вставить(Код, Строка_);
		Если Не Строка_.Авто Тогда
			Значения.Вставить(Код, ЧислоИлиНоль(Строка_.Сумма));
		КонецЕсли;
	КонецЦикла;

	// Шаг 1 — прямые источники (перенос из FI, суммы по Обрасцу OA).
	Для Каждого КлючИЗначение Из СтрокиПоКоду Цикл
		Строка_ = КлючИЗначение.Значение;
		Если Не Строка_.Авто Тогда
			Продолжить;
		КонецЕсли;
		Источник = Источники.Получить(КлючИЗначение.Ключ);
		Если Источник = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Величина = ПрямойИсточникPD(Источник);
		Если Величина <> Неопределено Тогда
			Строка_.Сумма = Окр(Величина, 2);
			Значения.Вставить(КлючИЗначение.Ключ, Строка_.Сумма);
		КонецЕсли;
	КонецЦикла;

	// Шаг 2 — формулы, min и налоговая шкала, многопроходно до стабилизации.
	Для Проход = 1 По 15 Цикл
		Изменений = 0;
		Для Каждого КлючИЗначение Из СтрокиПоКоду Цикл
			Если Значения.Получить(КлючИЗначение.Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Строка_ = КлючИЗначение.Значение;
			Если Не Строка_.Авто Тогда
				Продолжить;
			КонецЕсли;
			Источник = Источники.Получить(КлючИЗначение.Ключ);
			Если Источник = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Успех = Истина;
			Величина = Неопределено;

			Если НачинаетсяС(Источник, "formulaPos:") Тогда
				Величина = ВычислитьВыражение(Сред(Источник, 12), Значения, Успех);
				Если Успех Тогда
					Величина = Макс(Величина, 0);
				КонецЕсли;
			ИначеЕсли НачинаетсяС(Источник, "formula:") Тогда
				Величина = ВычислитьВыражение(Сред(Источник, 9), Значения, Успех);
			ИначеЕсли НачинаетсяС(Источник, "min:") Тогда
				Части = СтрРазделить(Сред(Источник, 5), ",", Ложь);
				Если Части.Количество() < 2 Тогда
					Успех = Ложь;
				Иначе
					Первое = Значения.Получить(СокрЛП(Части[0]));
					Второе = Значения.Получить(СокрЛП(Части[1]));
					Если Первое = Неопределено ИЛИ Второе = Неопределено Тогда
						Успех = Ложь;
					Иначе
						Величина = Мин(Первое, Второе);
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли НачинаетсяС(Источник, "taxScaleA:") Тогда
				Величина = ЗначениеШкалы(Сред(Источник, 11), "A", Значения, Успех);
			ИначеЕсли НачинаетсяС(Источник, "taxScaleB:") Тогда
				Величина = ЗначениеШкалы(Сред(Источник, 11), "B", Значения, Успех);
			ИначеЕсли НачинаетсяС(Источник, "taxScaleC:") Тогда
				Величина = ЗначениеШкалы(Сред(Источник, 11), "C", Значения, Успех);
			ИначеЕсли НачинаетсяС(Источник, "taxScale:") Тогда
				Величина = ЗначениеШкалы(Сред(Источник, 10), "", Значения, Успех);
			Иначе
				Продолжить;
			КонецЕсли;

			Если Успех И Величина <> Неопределено Тогда
				Строка_.Сумма = Окр(Величина, 2);
				Значения.Вставить(КлючИЗначение.Ключ, Строка_.Сумма);
				Изменений = Изменений + 1;
			КонецЕсли;
		КонецЦикла;
		Если Изменений = 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	// Не разрешённые за 15 проходов авто-строки обнуляем.
	Для Каждого КлючИЗначение Из СтрокиПоКоду Цикл
		Если Значения.Получить(КлючИЗначение.Ключ) = Неопределено
			И КлючИЗначение.Значение.Авто Тогда
			КлючИЗначение.Значение.Сумма = 0;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ЗначениеШкалы(Знач КодБазы, Знач Часть, Значения, Успех)

	База = Значения.Получить(СокрЛП(КодБазы));
	Если База = Неопределено Тогда
		Успех = Ложь;
		Возврат 0;
	КонецЕсли;

	Возврат НалогПоШкале(База, Часть);

КонецФункции

// Строит ТЧ PDСтроки по макету ПравилаPD, сохраняя ранее введённые вручную суммы.
Процедура ЗаполнитьPD() Экспорт

	Старые = Новый Соответствие;
	Для Каждого Строка_ Из PDСтроки Цикл
		Старые.Вставить(СокрЛП(Строка_.Код), ЧислоИлиНоль(Строка_.Сумма));
	КонецЦикла;

	PDСтроки.Очистить();

	Для Каждого Правило Из ПравилаPD() Цикл
		Код = СокрЛП(Строка(Правило.Получить("code")));
		Если Код = "" Тогда
			Продолжить;
		КонецЕсли;
		Источник = СокрЛП(Строка(Правило.Получить("source")));

		НоваяСтрока = PDСтроки.Добавить();
		НоваяСтрока.Код = Лев(Код, 10);
		НоваяСтрока.Наименование = Лев(Строка(Правило.Получить("label")), 300);
		НоваяСтрока.Авто = (Источник <> "manual" И Источник <> "");
		Если Не НоваяСтрока.Авто Тогда
			Прежнее = Старые.Получить(Код);
			НоваяСтрока.Сумма = ?(Прежнее = Неопределено, 0, Прежнее);
		КонецЕсли;
	КонецЦикла;

	ПересчитатьPD();

КонецПроцедуры

#КонецОбласти

#Область ВыгрузкаXML

Процедура ЗаполнитьЗаглавлеFI(Заглавле)

	Если Заглавле = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НазивОбвезника = "";
	Если ЗначениеЗаполнено(Организация) Тогда
		НазивОбвезника = Строка(Организация.Наименование);
	КонецЕсли;

	УстановитьТекстУзла(Заглавле, "Godina", ГодСтрокой(Год));
	УстановитьТекстУзла(Заглавле, "DatumOd", "01.01." + ГодСтрокой(Год));
	УстановитьТекстУзла(Заглавле, "DatumDo", "31.12." + ГодСтрокой(Год));
	УстановитьТекстУзла(Заглавле, "NazivObveznika", НазивОбвезника);
	УстановитьТекстУзла(Заглавле, "SifraDjelatnosti", СифраДјелатности);
	УстановитьТекстУзла(Заглавле, "MaticniBroj", МатичниБрој);
	УстановитьТекстУзла(Заглавле, "LiceKojeSastavljaIskaz_Naziv", ЛицеНазив);
	УстановитьТекстУзла(Заглавле, "LiceKojeSastavljaIskaz_JMBG", ЛицеJMBG);
	УстановитьТекстУзла(Заглавле, "LiceKojeSastavljaIskaz_Email", ЛицеEmail);
	УстановитьТекстУзла(Заглавле, "OdgovornoLice_Ime", ОдгЛицеИме);
	УстановитьТекстУзла(Заглавле, "OdgovornoLice_Prezime", ОдгЛицеПрезиме);
	УстановитьТекстУзла(Заглавле, "OdgovornoLice_JMBG", ОдгЛицеJMBG);
	УстановитьТекстУзла(Заглавле, "FinansijskiIzvestajSastavljenNaDan",
		Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy"));
	// SjedisteObveznika и FinansijskiIzvestajPodnesenNaDan остаются как в шаблоне.

КонецПроцедуры

Процедура ЗаполнитьУзлыКапитала(СекцияУзел)

	Индекс = 0;
	Для Каждого Ставка Из СекцияУзел.ДочерниеУзлы Цикл
		Если Ставка.ТипУзла <> ТипУзлаDOM.Элемент ИЛИ Ставка.ИмяУзла <> "Stavka" Тогда
			Продолжить;
		КонецЕсли;
		Индекс = Индекс + 1;
		Если Индекс > СтрокиКапитала.Количество() Тогда
			Прервать;
		КонецЕсли;
		Строка_ = СтрокиКапитала[Индекс - 1];
		Для НомерКолонки = 2 По 11 Цикл
			ИмяКолонки = "Iznos" + Строка(НомерКолонки);
			Узел = НайтиДочерний(Ставка, ИмяКолонки);
			Если Узел <> Неопределено Тогда
				Узел.ТекстовоеСодержимое = ЧислоДляXML(Строка_[ИмяКолонки]);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьУзлыАмортизации(СекцияУзел)

	ПоГруппе = Новый Соответствие;
	Для Каждого Строка_ Из СтрокиАмортизации Цикл
		ПоГруппе.Вставить(СокрЛП(Строка_.Grupa), Строка_);
	КонецЦикла;

	Для Каждого Ставка Из СекцияУзел.ДочерниеУзлы Цикл
		Если Ставка.ТипУзла <> ТипУзлаDOM.Элемент ИЛИ Ставка.ИмяУзла <> "Stavka" Тогда
			Продолжить;
		КонецЕсли;
		Группа = ТекстУзла(Ставка, "Grupa");
		Строка_ = ПоГруппе.Получить(Группа);
		Если Строка_ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для НомерКолонки = 2 По 8 Цикл
			ИмяКолонки = "Iznos" + Строка(НомерКолонки);
			Узел = НайтиДочерний(Ставка, ИмяКолонки);
			Если Узел <> Неопределено Тогда
				Узел.ТекстовоеСодержимое = ЧислоДляXML(Строка_[ИмяКолонки]);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Выгрузка Finansijskih iskaza в XML по шаблону ШаблонFI.
Функция ВыгрузитьXMLФИ(ПутьФайла) Экспорт

	Документ = ПрочитатьМакетXML("ШаблонFI");
	Корень = КореньДокумента(Документ, "FinansijskiIskazi");

	ЗаполнитьЗаглавлеFI(НайтиДочерний(Корень, "Zaglavlje"));

	ЗначенияСтрок = Новый Соответствие;
	Для Каждого Строка_ Из Строки Цикл
		Номер = СокрЛП(Строка_.RedniBroj);
		Если Номер = "" Тогда
			Продолжить;
		КонецЕсли;
		ЗначенияСтрок.Вставить(Строка_.Секция + "|" + Номер, Строка_);
	КонецЦикла;

	Для Каждого СекцияУзел Из Корень.ДочерниеУзлы Цикл
		Если СекцияУзел.ТипУзла <> ТипУзлаDOM.Элемент Тогда
			Продолжить;
		КонецЕсли;
		ИмяСекции = СекцияУзел.ИмяУзла;
		Если ИмяСекции = "Zaglavlje" Тогда
			Продолжить;
		ИначеЕсли ИмяСекции = "IskazOPromenamaKapitala" Тогда
			ЗаполнитьУзлыКапитала(СекцияУзел);
			Продолжить;
		ИначеЕсли ИмяСекции = "ObracunAmortizacije" Тогда
			ЗаполнитьУзлыАмортизации(СекцияУзел);
			Продолжить;
		КонецЕсли;

		Для Каждого Ставка Из СекцияУзел.ДочерниеУзлы Цикл
			Если Ставка.ТипУзла <> ТипУзлаDOM.Элемент ИЛИ Ставка.ИмяУзла <> "Stavka" Тогда
				Продолжить;
			КонецЕсли;
			Номер = ТекстУзла(Ставка, "RedniBroj");
			Если Номер = "" Тогда
				Продолжить;
			КонецЕсли;
			Строка_ = ЗначенияСтрок.Получить(ИмяСекции + "|" + Номер);
			Если Строка_ = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Для НомерКолонки = 1 По 3 Цикл
				ИмяКолонки = "Iznos" + Строка(НомерКолонки);
				Узел = НайтиДочерний(Ставка, ИмяКолонки);
				Если Узел <> Неопределено Тогда
					Узел.ТекстовоеСодержимое = ЧислоДляXML(Строка_[ИмяКолонки]);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	ЗаписатьДокументDOM(Документ, ПутьФайла);

	Возврат ПутьФайла;

КонецФункции

// Выгрузка Prijave poreza na dobit (PD) в XML по шаблону ШаблонPD.
Функция ВыгрузитьXMLПД(ПутьФайла) Экспорт

	Документ = ПрочитатьМакетXML("ШаблонPD");
	Корень = КореньДокумента(Документ, "PD");

	УстановитьТекстУзла(Корень, "PoreskiPeriodOd", "01.01." + ГодСтрокой(Год));
	УстановитьТекстУзла(Корень, "PoreskiPeriodDo", "31.12." + ГодСтрокой(Год));

	НазивОбвезника = "";
	ПИБ = "";
	Если ЗначениеЗаполнено(Организация) Тогда
		НазивОбвезника = Строка(Организация.Наименование);
		ПИБ = СокрЛП(Строка(Организация.ИНН));
	КонецЕсли;

	Заглавле = НайтиДочерний(Корень, "Zaglavlje");
	Если Заглавле <> Неопределено Тогда
		УстановитьТекстУзла(Заглавле, "Naziv", НазивОбвезника);
		УстановитьТекстУзла(Заглавле, "Pib", ПИБ);
		УстановитьТекстУзла(Заглавле, "OdgovornoLice_Naziv",
			СокрЛП(СокрЛП(ОдгЛицеИме) + " " + СокрЛП(ОдгЛицеПрезиме)));
		УстановитьТекстУзла(Заглавле, "OdgovornoLice_JMBG", ОдгЛицеJMBG);
	КонецЕсли;

	Для Каждого Строка_ Из PDСтроки Цикл
		Код = СокрЛП(Строка_.Код);
		Если Код = "" Тогда
			Продолжить;
		КонецЕсли;
		Узел = НайтиДочерний(Корень, "Iznos" + Код);
		Если Узел <> Неопределено Тогда
			Узел.ТекстовоеСодержимое = ЧислоДляXML(Строка_.Сумма);
		КонецЕсли;
	КонецЦикла;

	ЗаписатьДокументDOM(Документ, ПутьФайла);

	Возврат ПутьФайла;

КонецФункции

#КонецОбласти

#Область ТабличныйДокумент

Процедура ВывестиЯчейку(ТабДок, Знач НомерСтроки, Знач НомерКолонки, Знач Значение,
	Знач Жирный = Ложь, Знач ЭтоЧисло = Ложь)

	Область = ТабДок.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);

	Если ЭтоЧисло Тогда
		Область.Текст = Формат(ЧислоИлиНоль(Значение), "ЧДЦ=2");
		Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
	Иначе
		Область.Текст = Строка(Значение);
	КонецЕсли;

	Если Жирный Тогда
		Область.Шрифт = Новый Шрифт(Область.Шрифт, , , Истина);
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьШиринуКолонки(ТабДок, Знач НомерКолонки, Знач Ширина)

	Область = ТабДок.Область(1, НомерКолонки, 1, НомерКолонки);
	Область.ШиринаКолонки = Ширина;

КонецПроцедуры

// Программное формирование просмотра/печатной формы (без макета СКД).
Процедура СформироватьПросмотр(ТабДок) Экспорт

	ТабДок.Очистить();

	НомерСтроки = 1;

	ВывестиЯчейку(ТабДок, НомерСтроки, 1, "Финансијски искази ЦГ", Истина);
	НомерСтроки = НомерСтроки + 1;
	ВывестиЯчейку(ТабДок, НомерСтроки, 1, "Организација: "
		+ ?(ЗначениеЗаполнено(Организация), Строка(Организация), "<није изабрана>"));
	НомерСтроки = НомерСтроки + 1;
	ВывестиЯчейку(ТабДок, НомерСтроки, 1, "Година: " + ГодСтрокой(Год));
	НомерСтроки = НомерСтроки + 2;

	УстановитьШиринуКолонки(ТабДок, 1, 10);
	УстановитьШиринуКолонки(ТабДок, 2, 70);
	УстановитьШиринуКолонки(ТабДок, 3, 16);
	УстановитьШиринуКолонки(ТабДок, 4, 16);
	УстановитьШиринуКолонки(ТабДок, 5, 16);

	ТекущаяСекция = "";
	Для Каждого Строка_ Из Строки Цикл
		Если Строка_.Секция <> ТекущаяСекция Тогда
			ТекущаяСекция = Строка_.Секция;
			НомерСтроки = НомерСтроки + 1;
			ВывестиЯчейку(ТабДок, НомерСтроки, 1, ТекущаяСекция, Истина);
			НомерСтроки = НомерСтроки + 1;
			ВывестиЯчейку(ТабДок, НомерСтроки, 1, "R.br.", Истина);
			ВывестиЯчейку(ТабДок, НомерСтроки, 2, "Pozicija", Истина);
			ВывестиЯчейку(ТабДок, НомерСтроки, 3, "Iznos 1", Истина);
			ВывестиЯчейку(ТабДок, НомерСтроки, 4, "Iznos 2", Истина);
			ВывестиЯчейку(ТабДок, НомерСтроки, 5, "Iznos 3", Истина);
			НомерСтроки = НомерСтроки + 1;
		КонецЕсли;

		Жирный = (Строка_.Kind = "formula" ИЛИ Строка_.Kind = "header");

		ВывестиЯчейку(ТабДок, НомерСтроки, 1, Строка_.RedniBroj, Жирный);
		ВывестиЯчейку(ТабДок, НомерСтроки, 2, Строка_.Позиция, Жирный);
		Если Строка_.Kind <> "header" Тогда
			ВывестиЯчейку(ТабДок, НомерСтроки, 3, Строка_.Iznos1, Жирный, Истина);
			ВывестиЯчейку(ТабДок, НомерСтроки, 4, Строка_.Iznos2, Жирный, Истина);
			ВывестиЯчейку(ТабДок, НомерСтроки, 5, Строка_.Iznos3, Жирный, Истина);
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

	// Блок Обрасца OA
	Если СтрокиАмортизации.Количество() > 0 Тогда
		НомерСтроки = НомерСтроки + 1;
		ВывестиЯчейку(ТабДок, НомерСтроки, 1, "Obračun amortizacije (Obrazac OA)", Истина);
		НомерСтроки = НомерСтроки + 1;
		ВывестиЯчейку(ТабДок, НомерСтроки, 1, "Grupa", Истина);
		ВывестиЯчейку(ТабДок, НомерСтроки, 2, "Početni saldo / Kupovina / Prodaja", Истина);
		ВывестиЯчейку(ТабДок, НомерСтроки, 3, "Neotpisana", Истина);
		ВывестиЯчейку(ТабДок, НомерСтроки, 4, "Stopa %", Истина);
		ВывестиЯчейку(ТабДок, НомерСтроки, 5, "Amortizacija", Истина);
		НомерСтроки = НомерСтроки + 1;
		Для Каждого Строка_ Из СтрокиАмортизации Цикл
			ВывестиЯчейку(ТабДок, НомерСтроки, 1, Строка_.Grupa);
			ВывестиЯчейку(ТабДок, НомерСтроки, 2, Формат(Строка_.Iznos2, "ЧДЦ=2") + " / "
				+ Формат(Строка_.Iznos3, "ЧДЦ=2") + " / " + Формат(Строка_.Iznos4, "ЧДЦ=2"));
			ВывестиЯчейку(ТабДок, НомерСтроки, 3, Строка_.Iznos5, Ложь, Истина);
			ВывестиЯчейку(ТабДок, НомерСтроки, 4, Строка_.Iznos6, Ложь, Истина);
			ВывестиЯчейку(ТабДок, НомерСтроки, 5, Строка_.Iznos7, Ложь, Истина);
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;
	КонецЕсли;

	// Блок PD
	Если PDСтроки.Количество() > 0 Тогда
		НомерСтроки = НомерСтроки + 1;
		ВывестиЯчейку(ТабДок, НомерСтроки, 1, "Prijava poreza na dobit (PD)", Истина);
		НомерСтроки = НомерСтроки + 1;
		ВывестиЯчейку(ТабДок, НомерСтроки, 1, "R.br.", Истина);
		ВывестиЯчейку(ТабДок, НомерСтроки, 2, "Naziv", Истина);
		ВывестиЯчейку(ТабДок, НомерСтроки, 3, "Iznos", Истина);
		НомерСтроки = НомерСтроки + 1;
		Для Каждого Строка_ Из PDСтроки Цикл
			ВывестиЯчейку(ТабДок, НомерСтроки, 1, Строка_.Код, Не Строка_.Авто);
			ВывестиЯчейку(ТабДок, НомерСтроки, 2, Строка_.Наименование, Ложь);
			ВывестиЯчейку(ТабДок, НомерСтроки, 3, Строка_.Сумма, Строка_.Авто, Истина);
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Каталог для файлов выгрузки: реквизит КаталогВыгрузки, а если он пуст —
// временный каталог сервера. Всегда завершается разделителем пути.
Функция КаталогДляВыгрузки() Экспорт

	Каталог = СокрЛП(Строка(КаталогВыгрузки));
	Если Каталог = "" Тогда
		Каталог = КаталогВременныхФайлов();
	КонецЕсли;

	ПоследнийСимвол = Прав(Каталог, 1);
	Если ПоследнийСимвол <> "\" И ПоследнийСимвол <> "/" Тогда
		Каталог = Каталог + ПолучитьРазделительПути();
	КонецЕсли;

	Возврат Каталог;

КонецФункции

// Базовое имя файла выгрузки без расширения: <ПИБ>_<Год> либо <Год>.
Функция СуффиксИмениФайла() Экспорт

	Суффикс = ГодСтрокой(Год);

	Если ЗначениеЗаполнено(Организация) Тогда
		ПИБ = СокрЛП(Строка(Организация.ИНН));
		Если ПИБ <> "" Тогда
			Суффикс = ПИБ + "_" + Суффикс;
		КонецЕсли;
	КонецЕсли;

	Возврат Суффикс;

КонецФункции

// Формат: "XLSX" (по умолчанию) или "PDF".
Функция ВыгрузитьОтчет(ПутьФайла, ФорматФайла = "XLSX") Экспорт

	ТабДок = Новый ТабличныйДокумент;
	СформироватьПросмотр(ТабДок);

	Если ВРег(СокрЛП(Строка(ФорматФайла))) = "PDF" Тогда
		ТабДок.Записать(ПутьФайла, ТипФайлаТабличногоДокумента.PDF);
	Иначе
		ТабДок.Записать(ПутьФайла, ТипФайлаТабличногоДокумента.XLSX);
	КонецЕсли;

	Возврат ПутьФайла;

КонецФункции

#КонецОбласти

#Область HeadlessAPI

// Находит организацию по точному наименованию, ставит реквизиты и считает всё.
Процедура ЗаполнитьПоПараметрам(ИмяОрганизации, ГодОтчета) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Орг.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Орг
	|ГДЕ
	|	Орг.Наименование = &Имя
	|	И НЕ Орг.ПометкаУдаления";
	Запрос.УстановитьПараметр("Имя", ИмяОрганизации);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "FinIskaziCG: организација није пронађена: " + Строка(ИмяОрганизации);
	КонецЕсли;

	Организация = Выборка.Ссылка;
	Год = ГодОтчета;

	Заполнить();
	ЗаполнитьPD();

КонецПроцедуры

// {"org":..., "year":..., "sections":{"BilanStanja":{"001":[i1,i2,i3],...},...},"pd":{...}}
Функция ПолучитьСтрокиJSON() Экспорт

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  "));

	Запись.ЗаписатьНачалоОбъекта();

	Запись.ЗаписатьИмяСвойства("org");
	Запись.ЗаписатьЗначение(?(ЗначениеЗаполнено(Организация), Строка(Организация.Наименование), ""));

	Запись.ЗаписатьИмяСвойства("year");
	Запись.ЗаписатьЗначение(ЧислоИлиНоль(Год));

	Запись.ЗаписатьИмяСвойства("sections");
	Запись.ЗаписатьНачалоОбъекта();

	ТекущаяСекция = "";
	Для Каждого Строка_ Из Строки Цикл
		Если Строка_.Секция <> ТекущаяСекция Тогда
			Если ТекущаяСекция <> "" Тогда
				Запись.ЗаписатьКонецОбъекта();
			КонецЕсли;
			ТекущаяСекция = Строка_.Секция;
			Запись.ЗаписатьИмяСвойства(ТекущаяСекция);
			Запись.ЗаписатьНачалоОбъекта();
		КонецЕсли;
		Номер = СокрЛП(Строка_.RedniBroj);
		Если Номер = "" Тогда
			Продолжить;
		КонецЕсли;
		Запись.ЗаписатьИмяСвойства(Номер);
		Запись.ЗаписатьНачалоМассива();
		Запись.ЗаписатьЗначение(ЧислоИлиНоль(Строка_.Iznos1));
		Запись.ЗаписатьЗначение(ЧислоИлиНоль(Строка_.Iznos2));
		Запись.ЗаписатьЗначение(ЧислоИлиНоль(Строка_.Iznos3));
		Запись.ЗаписатьКонецМассива();
	КонецЦикла;
	Если ТекущаяСекция <> "" Тогда
		Запись.ЗаписатьКонецОбъекта();
	КонецЕсли;

	Запись.ЗаписатьКонецОбъекта();

	Запись.ЗаписатьИмяСвойства("pd");
	Запись.ЗаписатьНачалоОбъекта();
	Для Каждого Строка_ Из PDСтроки Цикл
		Номер = СокрЛП(Строка_.Код);
		Если Номер = "" Тогда
			Продолжить;
		КонецЕсли;
		Запись.ЗаписатьИмяСвойства(Номер);
		Запись.ЗаписатьЗначение(ЧислоИлиНоль(Строка_.Сумма));
	КонецЦикла;
	Запись.ЗаписатьКонецОбъекта();

	Запись.ЗаписатьКонецОбъекта();

	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти
