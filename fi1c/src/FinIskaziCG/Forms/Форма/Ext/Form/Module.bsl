////////////////////////////////////////////////////////////////////////////////
// FinIskaziCG — модуль управляемой формы.
//
// Вся работа с данными — на сервере, через РеквизитФормыВЗначение("Объект")
// и экспортные методы модуля объекта. На клиенте нет обращений к серверным
// объектам, только вызовы &НаСервере-методов и вывод сообщений.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Объект.Год) Тогда
		Объект.Год = Год(ТекущаяДатаСеанса()) - 1;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)

	ЗаполнитьНаСервере();
	Сообщить("Извјештај је попуњен.");

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКонтроли(Команда)

	Текст = ПроверитьКонтролиНаСервере();
	Если ПустаяСтрока(Текст) Тогда
		Сообщить("Контроле су прошле без одступања.");
	Иначе
		Сообщить("Пронађена одступања:");
		Сообщить(Текст);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьФИ(Команда)

	Сообщить("XML ФИ: " + ВыгрузитьНаСервере("FI"));

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПД(Команда)

	Сообщить("XML ПД: " + ВыгрузитьНаСервере("PD"));

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьExcel(Команда)

	Сообщить("Excel: " + ВыгрузитьНаСервере("XLSX"));

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьPDF(Команда)

	Сообщить("PDF: " + ВыгрузитьНаСервере("PDF"));

КонецПроцедуры

#КонецОбласти

#Область СерверныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");

	Если Не ЗначениеЗаполнено(Обработка.Год) Тогда
		Обработка.Год = Год(ТекущаяДатаСеанса()) - 1;
	КонецЕсли;

	Обработка.Заполнить();
	Обработка.ЗаполнитьPD();
	Обработка.СформироватьПросмотр(ТабДок);

	ЗначениеВРеквизитФормы(Обработка, "Объект");

КонецПроцедуры

&НаСервере
Функция ПроверитьКонтролиНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.ПроверитьКонтроли();

	Возврат Результат;

КонецФункции

// Вид: "FI" | "PD" | "XLSX" | "PDF". Файлы кладутся в КаталогВыгрузки
// (если реквизит пуст — во временный каталог сервера).
&НаСервере
Функция ВыгрузитьНаСервере(Вид)

	Обработка = РеквизитФормыВЗначение("Объект");

	Каталог = Обработка.КаталогДляВыгрузки();
	Суффикс = Обработка.СуффиксИмениФайла();

	Если Вид = "FI" Тогда
		Результат = Обработка.ВыгрузитьXMLФИ(Каталог + "FI_" + Суффикс + ".xml");
	ИначеЕсли Вид = "PD" Тогда
		Результат = Обработка.ВыгрузитьXMLПД(Каталог + "PD_" + Суффикс + ".xml");
	ИначеЕсли Вид = "PDF" Тогда
		Результат = Обработка.ВыгрузитьОтчет(Каталог + "FI_" + Суффикс + ".pdf", "PDF");
	Иначе
		Результат = Обработка.ВыгрузитьОтчет(Каталог + "FI_" + Суффикс + ".xlsx", "XLSX");
	КонецЕсли;

	ЗначениеВРеквизитФормы(Обработка, "Объект");

	Возврат Результат;

КонецФункции

#КонецОбласти
